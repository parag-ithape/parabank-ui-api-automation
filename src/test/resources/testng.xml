<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- data-provider-thread-count = how many scenarios run at once.
     Default 1: scenarios run one after another in a single browser. Parallel: -DdpThreads=N
     (each thread then has its own browser; keep N at 2-3 on the shared public site). -->
<suite name="ParaBank" data-provider-thread-count="1">
  <test name="Framework checks" preserve-order="true">
    <classes><class name="utils.LocatorIntegrityTest"/></classes>
  </test>
  <test name="Scenarios">
    <classes><class name="runner.CucumberTestRunner"/></classes>
  </test>
</suite>
